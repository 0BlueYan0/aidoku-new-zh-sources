latestChapterInfo":"{\"name\":\"38\\u5377\",\"id\":650237,\"car_id\":95753}","color":{"r":105,"g":95,"b":81},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"b6b7bba2885814b98b903a9a815c8593","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=76717","chapter_num":40,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"欧美","read_mode":1,"dis_type":"条漫","length":"","color_type":"彩漫","is_audit":1,"sub_num":0,"first_char":"X","in_book":0,"tag":[],"cat":[{"id":7,"name":"科幻","num":0,"created_at":"2024-08-19 13:52:36","updated_at":"2024-08-19 13:52:36","value":"科幻","pivot":{"car_id":95753,"cat_id":7}}]}}],["$","$Ld",null,{"item":{"id":141222,"name":"青与春","cover":"https://cdm.vomicer.com/2886905dc01dd2dea9f0c7e8c3116022-cover?sign=f83879e3400eaa498c713272186d8507&t=1791024613&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"与超人气男生的冲击性邂逅——？ 闪耀的青春爱情故事开幕！！","updated_at":"2026-10-03 18:47:28","created_at":"2026-05-21 01:27:56","author":"日下あき","upload_id":1033,"status":1,"cat_id":0,"likes_num":29,"collect_num":107,"view_num":1758,"can_comment":1,"comment_num":10,"user_id":9999,"process":"连载中","sex":"全部","tags":"","creativity":"转载","score_num":22,"score":"5.0","process_at":"2026-10-03 08:27:16","hot_value":85,"latestChapterInfo":"{\"name\":\"7\\u8bdd\",\"id\":650236,\"car_id\":141222}","color":{"r":191,"g":195,"b":196},"has_content_score_num":6,"cover_expired_at":null,"legal":0,"identity":"2886905dc01dd2dea9f0c7e8c3116022","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=86505","chapter_num":7,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"","read_mode":1,"dis_type":"条漫","length":"","color_type":"","is_audit":0,"sub_num":5,"first_char":"Q","in_book":0,"tag":[],"cat":[{"id":8,"name":"爱情","num":0,"created_at":"2024-08-19 13:52:36","updated_at":"2024-08-19 13:52:36","value":"爱情,恋爱,亲情","pivot":{"car_id":141222,"cat_id":8}},{"id":12,"name":"校园","num":0,"created_at":"2024-08-19 13:52:36","updated_at":"2024-08-19 13:52:36","value":"校园","pivot":{"car_id":141222,"cat_id":12}}]}}],["$","$Ld",null,{"item":{"id":146751,"name":"以为是第二次人生，没想到其实是第三次。","cover":"https://cdm.vomicer.com/b377c928e98d4a8af7b697987d10b82d-cover?sign=478b7a8736f704d5db1360d5ee5b662e&t=1791024613&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"被嘲笑为无能者的青年男爵——塔克希尔，只能眼睁睁看着深爱的家人逝去，自己却无能为力。 然而在临死之际，他突然受到时空魔法的作用，带着“前前世”的记忆逆行回到了幼年时期！？ “——这次我一定要拯救我的家人！” 凭藉着第一世的现代知识与第二世的记忆，在“事不过三”的第三次人生中，他挺身迎战即将降临在家族身上的灾难。 他发明了水车、干面等文明利器，借此迎击即将到来的歉收饥荒！ 结果，他那不顾一切的行动、力量与钢铁般的意志获得了认可，这次甚至连可靠的人才都成为了他的同伴……！？ “家人至上”的麒麟儿打破悲惨命运！ 史无前例的盛大反叛剧，就此开幕！","updated_at":"2026-10-03 17:33:01","created_at":"2026-09-22 10:43:25","author":" take4 麦こうちゃ","upload_id":1036,"status":1,"cat_id":0,"likes_num":0,"collect_num":10,"view_num":366,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"","creativity":"转载","score_num":2,"score":"5.0","process_at":"2026-10-03 08:26:25","hot_value":14,"latestChapterInfo":"{\"name\":\"12\\u8bdd\",\"id\":650235,\"car_id\":146751}","color":{"r":147,"g":135,"b":126},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"b377c928e98d4a8af7b697987d10b82d","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=88393","chapter_num":12,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"","read_mode":1,"dis_type":"条漫","length":"","color_type":"","is_audit":0,"sub_num":0,"first_char":"Y","in_book":0,"tag":[],"cat":[{"id":4,"name":"冒险","num":0,"created_at":"2024-08-19 13:50:41","updated_at":"2024-08-19 13:50:41","value":"冒险","pivot":{"car_id":146751,"cat_id":4}},{"id":23,"name":"奇幻","num":0,"created_at":"2024-08-19 13:52:36","updated_at":"2024-08-19 13:52:36","value":"奇幻,玄幻,西幻","pivot":{"car_id":146751,"cat_id":23}}]}}],["$","$Ld",null,{"item":{"id":143470,"name":"哥斯拉征服多元宇宙","cover":"https://cdm.vomicer.com/f73b3cf149a1a2066cfb3017923b91bf-cover?sign=688857d75500f9658d43e99cd9f6e81e&t=1791024613&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"在前作哥斯拉毁灭漫威宇宙中，共生体之神纳尔与哥斯拉结成邪恶同盟，征服了漫威宇宙，让一众英雄如今濒临覆灭！而为了对抗这一威胁，毁灭博士开始在多元宇宙中寻找能与哥斯拉对抗的存在。但他无法预料的是，这一举动或许会让这头恶兽开始踏上撕裂整个多元宇宙的狂暴之旅……","updated_at":"2026-10-03 16:22:29","created_at":"2026-08-05 03:31:08","author":"Gerry Duggan Javier Garron","upload_id":1040,"status":1,"cat_id":0,"likes_num":0,"collect_num":0,"view_num":77,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"","creativity":"转载","score_num":1,"score":"5.0","process_at":"2026-10-03 08:20:30","hot_value":0,"latestChapterInfo":"{\"name\":\"3\\u5377\",\"id\":650234,\"car_id\":143470}","color":{"r":107,"g":87,"b":76},"has_content_score_num":1,"cover_expired_at":null,"legal":0,"identity":"f73b3cf149a1a2066cfb3017923b91bf","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=87651","chapter_num":3,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"","read_mode":1,"dis_type":"条漫","length":"","color_type":"","is_audit":0,"sub_num":0,"first_char":"G","in_book":0,"tag":[],"cat":[{"id":4,"name":"冒险","num":0,"created_at":"2024-08-19 13:50:41","updated_at":"2024-08-19 13:50:41","value":"冒险","pivot":{"car_id":143470,"cat_id":4}},{"id":7,"name":"科幻","num":0,"created_at":"2024-08-19 13:52:36","updated_at":"2024-08-19 13:52:36","value":"科幻","pivot":{"car_id":143470,"cat_id":7}}]}}],["$","$Ld",null,{"item":{"id":143633,"name":"Albedo 艾玛·菲奥娜 EDF","cover":"https://cdm.vomicer.com/e84c61781e60ad7b61bb7b0c732d9679-cover?sign=5b8cd0d29971a1935cdb36b47a398806&t=1791024613&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"这部漫画被称为“美国Furry(兽人)亚文化始祖”，其灵感部分来源于严肃的成人科幻政治剧《A Very British Coup》(又名《非常英国政变》)。\n女主角Erma Felna(艾玛·菲奥娜)，服役于[独立Lepin共和国](ILR)的“星际防卫军”(简称EDF)。剧中的反派是兔子星人联邦，致力于灭绝宇宙中的非