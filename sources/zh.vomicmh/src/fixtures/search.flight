":1294}},{"name":"投稿","pivot":{"car_id":31693,"tag_id":4286}},{"name":"奇幻","pivot":{"car_id":31693,"tag_id":402}},{"name":"其他","pivot":{"car_id":31693,"tag_id":4296}}],"cat":[{"id":25,"name":"其他","num":0,"created_at":"2024-08-19 13:52:36","updated_at":"2024-08-19 13:52:36","value":"其他,正能量","pivot":{"car_id":31693,"cat_id":25}}]}}],["$","$Ld",null,{"item":{"id":83467,"name":"哪一个？","cover":"https://cdm.vomicer.com/522d75b2abe2a192037e65990eef4e36-cover?sign=f78c9ecb2c953672354e32ed4f7ccc1d&t=1791024610&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"无法说出“真正的心意”...","updated_at":"2026-10-01 05:04:03","created_at":"2024-12-09 18:32:55","author":"ChrisTy","upload_id":1007,"status":1,"cat_id":0,"likes_num":0,"collect_num":1,"view_num":274,"can_comment":1,"comment_num":0,"user_id":9999,"process":"已完结","sex":"全部","tags":"ゆり","creativity":"转载","score_num":0,"score":"0.0","process_at":"2024-12-09 18:32:58","hot_value":3,"latestChapterInfo":"[]","color":{"r":209,"g":201,"b":201},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"522d75b2abe2a192037e65990eef4e36","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=56110","chapter_num":1,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"日本","read_mode":1,"dis_type":"条漫","length":"","color_type":"黑白","is_audit":1,"sub_num":0,"first_char":"N","tag":[{"name":"ゆり","pivot":{"car_id":83467,"tag_id":865}}],"cat":[]}}],["$","$Ld",null,{"item":{"id":19701,"name":"神哪，请给我个老公吧！","cover":"https://cdm.vomicer.com/90cf0d74425cea919846d85fb7b80be5-cover?sign=fac49081e53d86ce241b4cc040183ac3&t=1791024610&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"外公过世后，梅伊不知所措，因为在即将到来的30岁生日，若她没有结婚，就会失去宅邸的继承权……；另一方面，亚当面对妹妹留下的婴儿正感到苦恼万分，她信上写着请去拜托梅伊……。身分悬殊的初恋，遭到深院大宅的千金小姐梅伊狠狠抛弃之后，亚当成为了一位成功的创业家。睽违13年再度相见的两人，因为彼此的利害关系，决定要伪装结婚。但是不知道她当年为何提出分手的亚当，在这背后潜藏着报复屈辱的企图！\n","updated_at":"2026-10-03 18:32:25","created_at":"2024-11-16 20:11: