a:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"神哪，请给我个老公吧！ - vomic漫"}],["$","meta","3",{"name":"description","content":"  外公过世后，梅伊不知所措，因为在即将到来的30岁生日，若她没有结婚，就会失去宅邸的继承权……；另一方面，亚当面对妹妹留下的婴儿正感到苦恼万分，她信上写着请去拜托梅伊……。身分悬殊的初恋，遭到深院大宅的千金小姐梅伊狠狠抛弃之后，亚当成为了一位成功的创业家。睽违13年再度相见的两人，因为彼此的利害关系，决定要伪装结婚。但是不知道她当年为何提出分手的亚当，在这背后潜藏着报复屈辱的企图！\n"}],["$","meta","4",{"name":"keywords","content":"楠　桂 禾林 神哪，请给我个老公吧！ ,在线漫画,无广告,免费漫画,vomic漫,vomic漫画,看漫画,下拉 式漫画,日本漫画,短篇漫画"}],["$","link","5",{"rel":"canonical","href":"http://vomicmh.com/detail/19701"}],["$","meta","6",{"property":"og:title","content":"神哪，请给我个老公吧！ - vomic漫"}],["$","meta","7",{"property":"og:description","content":"  外公过世后，梅伊不知所措，因为在即将到来的30岁生日，若她没有结婚，就会失去宅邸的继承权……；另一方面，亚当面对妹妹留下的婴儿正感到苦恼万分，她信上写着请去拜托梅伊……。身分悬殊的初恋，遭到深院大宅的千金小姐梅伊狠狠抛弃之后，亚当成为了一位成功的创业家。睽违13年再度相见的两人，因为彼此的利害关系，决定要伪装结婚。但是不知道她当年为何提出分手的亚当，在这背后潜藏着报复屈辱的企图！\n"}],["$","meta","8",{"property":"og:url","content":"http://vomicmh.com/detail/19701"}],["$","meta","9",{"property":"og:site_name","content":"vomic漫"}],["$","meta","10",{"property":"og:locale","content":"zh_CN"}],["$","meta","11",{"property":"og:image","content":"https://cdm.vomicer.com/90cf0d74425cea919846d85fb7b80be5-cover?sign=8f3cb344a8adc00631c9dcc37b129d13&t=1791024811&imageMogr2/thumbnail/576x/format/webp/quality/75"}],["$","meta","12",{"property":"og:image:width","content":"300"}],["$","meta","13",{"property":"og:image:height","content":"400"}],["$","meta","14",{"property":"og:image:alt","content":"vomic漫"}],["$","meta","15",{"property":"og:type","content":"website"}],["$","meta","16",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","17",{"name":"twitter:title","content":"神哪，请给我个老公吧！ - vomic漫"}],["$","meta","18",{"name":"twitter:description","content":"  外公过世后，梅伊不知所措，因为在即将到来的30岁生日，若她没有结婚，就会失去宅邸的继承权……；另一方面，亚当面对妹妹留下的婴儿正感到苦恼万分，她信上写着请去拜托梅伊……。身分悬殊的初恋，遭到深院大宅的千金小姐梅伊狠狠抛弃之后，亚当成为了一位成功的创业家。睽违13年再度相见的两人，因为彼此的利害关系，决定要伪装结婚