3:["$","div",null,{"className":"w-full m-w ","children":[["$","$L9",null,{"type":"application/ld+json","children":"{\n           '@context': 'http://schema.org',\n           '@type': 'WebSite',\n           name: 'vomic漫',\n           description:\n             'vomic漫为您提供优质纯净的无广告漫画阅读体验。连载漫画，免费漫画，完结漫画，冒险漫画, 搞笑漫画, 动作漫画, 科幻漫画, 爱情漫画, 侦探漫画, 竞技漫画, 魔法漫画, 校园漫画, 百合漫画, 耽美漫画, 历史漫画, 战争漫画, 宅系漫画, 治愈漫画, 武侠漫画, 职场漫画, 神鬼漫画, 奇幻漫画',\n           url: http://vomicmh.com/so/cate/4/1,\n           potentialAction: {\n             '@type': 'SearchAction',\n             target: 'https://www.vomicmh.com/so/key/{search_term_string}/1',\n             'query-input': 'required name=search_term_string'\n           },\n           publisher: {\n             '@type': 'Organization',\n             name: 'vomic漫',\n             logo: {\n               '@type': 'ImageObject',\n               url: 'https://www.vomicmh.com/images/light.png',\n               width: 150,\n               height: 150\n             }\n           },\n           mainEntityOfPage: {\n             '@type': 'CollectionPage',\n             name: '首页'\n           }\n        }"}],["$","div",null,{"className":"card mt-4 p-2 rounded-md ","children":["$Lc",[["$","div",null,{"className":"text-base font-medium mt-6 text-major","children":"搜索结果"}],["$","div",null,{"className":"flex flex-wrap justify-between mt-2 ","children":[[["$","$Ld",null,{"item":{"id":69744,"name":"动感漫画：神奇☆女侠领衔主演","cover":"https://cdm.vomicer.com/7390453e061124cd8e2ebfe83cf27657-cover?sign=4cf268613bf7644fe421d20cceebde2e&t=1791024603&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"动感漫画的系列，神奇女侠主演。","updated_at":"2026-10-03 17:07:38","created_at":"2024-12-04 18:10:15","author":"DC Comics","upload_id":1017,"status":1,"cat_id":0,"likes_num":0,"collect_num":1,"view_num":1428,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"","creativity":"转载","score_num":0,"score":"0.0","process_at":"2026-10-03 08:34:11","hot_value":0,"latestChapterInfo":"{\"name\":\"40\\u5377\",\"id\":650241,\"car_id\":69744}","color":{"r":136,"g":118,"b":121},"has_content_score_num":0,"cover_expired_at":1721712982,"legal":0,"identity":"7390453e061124cd8e2ebfe83cf27657","webCode":"zaimanhua","is_deal":1,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=15928","chapter_num":40,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"欧美","read_mode":1,"dis_type":"条漫","length":"","color_type":"","is_audit":1,"sub_num":0,"first_char":"D"}}],["$","$Ld",null,{"item":{"id":146751,"name":"以为是第二次人生，没想到其实是第三次。","cover":"https://cdm.vomicer.com/b377c928e98d4a8af7b697987d10b82d-cover?sign=f9540b16c3ac6866585488d3815c3c0a&t=1791024603&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"被嘲笑为无能者的青年男爵——塔克希尔，只能眼睁睁看着深爱的家人逝去，自己却无能为力。 然而在临死之际，他突然受到时空魔法的作用，带着“前前世”的记忆逆行回到了幼年时期！？ “——这次我一定要拯救我的家人！” 凭藉着第一世的现代知识与第二世的记忆，在“事不过三”的第三次人生中，他挺身迎战即将降临在家族身上的灾难。 他发明了水车、干面等文明利器，借此迎击即将到来的歉收饥荒！ 结果，他那不顾一切的行动、力量与钢铁般的意志获得了认可，这次甚至连可靠的人才都成为了他的同伴……！？ “家人至上”的麒麟儿打破悲惨命运！ 史无前例的盛大反叛剧，就此开幕！","updated_at":"2026-10-03 17:33:01","created_at":"2026-09-22 10:43:25","author":" take4 麦こうちゃ","upload_id":1036,"status":1,"cat_id":0,"likes_num":0,"collect_num":10,"view_num":366,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"","creativity":"转载","score_num":2,"score":"5.0","process_at":"2026-10-03 08:26:25","hot_value":14,"latestChapterInfo":"{\"name\":\"12\\u8bdd\",\"id\":650235,\"car_id\":146751}","color":{"r":147,"g":135,"b":126},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"b377c928e98d4a8af7b697987d10b82d","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=88393","chapter_num":12,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"","read_mode":1,"dis_type":"条漫","length":"","color_type":"","is_audit":0,"sub_num":0,"first_char":"Y"}}],["$","$Ld",null,{"item":{"id":143470,"name":"哥斯拉征服多元宇宙","cover":"https://cdm.vomicer.com/f73b3cf149a1a2066cfb3017923b91bf-cover?sign=a92c752dce6c985aad621cc7bce384d0&t=1791024603&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"在前作哥斯拉毁灭漫威宇宙中，共生体之神纳尔与哥斯拉结成邪恶同盟，征服了漫威宇宙，让一众英雄如今濒临覆灭！而为了对抗这一威胁，毁灭博士开始在多元宇宙中寻找能与哥斯拉对抗的存在。但他无法预料的是，这一举动或许会让这头恶兽开始踏上撕裂整个多元宇宙的狂暴之旅……","updated_at":"2026-10-03 16:22:29","created_at":"2026-08-05 03:31:08","author":"Gerry Duggan Javier Garron","upload_id":1040,"status":1,"cat_id":0,"likes_num":0,"collect_num":0,"view_num":77,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"","creativity":"转载","score_num":1,"score":"5.0","process_at":"2026-10-03 08:20:30","hot_value":0,"latestChapterInfo":"{\"name\":\"3\\u5377\",\"id\":650234,\"car_id\":143470}","color":{"r":107,"g":87,"b":76},"has_content_score_num":1,"cover_expired_at":null,"legal":0,"identity":"f73b3cf149a1a2066cfb3017923b91bf","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=87651","chapter_num":3,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"","read_mode":1,"dis_type":"条漫","length":"","color_type":"","is_audit":0,"sub_num":0,"first_char":"G"}}],["$","$Ld",null,{"item":{"id":142720,"name":"探险时光（2025）","cover":"https://cdm.vomicer.com/d7987fe25c499f8a1c145e9b3d2727cd-cover?sign=fe97bb1ad54633b28a3281ea4d303312&t=1791024603&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"男孩芬恩与大黄狗杰克的冒险之旅再次继续！继之前的75期漫画结束后，探险时光又迎来了全新的漫画连载！值得一提的是该漫画大部分设定与动画是一样的，但一些细节与动画不同，比如后面芬恩断臂的原因，老英雄比利的命运等等。可以看作是动画的平行世界，但会补充更多动画里没有的细节，绝对值得一看！","updated_at":"2026-10-03 18:17:25","created_at":"2026-07-14 07:29:31","author":"Nick Winn","upload_id":1048,"status":1,"cat_id":0,"likes_num":0,"collect_num":4,"view_num":314,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"欢乐向","creativity":"转载","score_num":2,"score":"5.0","process_at":"2026-10-03 07:44:59","hot_value":0,"latestChapterInfo":"{\"name\":\"16\\u5377\",\"id\":650230,\"car_id\":142720}","color":{"r":158,"g":122,"b":117},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"d7987fe25c499f8a1c145e9b3d2727cd","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=87294","chapter_num":16,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"","read_mode":1,"dis_type":"条漫","length":"","color_type":"","is_audit":0,"sub_num":0,"first_char":"T"}}],["$","$Ld",null,{"item":{"id":54597,"name":"用无敌的扭蛋运在异世界成名","cover":"https://cdm.vomicer.com/73c82d257be1670ee46ee507c7180256-cover?sign=9fb11b118aac7c01659c7972f0c4c1fb&t=1791024603&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"因交通事故死亡的仁太和天界女神·莉法相遇。本因在莉法的引导下成佛的仁太、由于意外和莉法一起转生去了异世界。转生后、发现仁太的能力值异常。运的最大值本来应该是“99”、而仁太的数值竟然变成了“999999”…!?","updated_at":"2026-10-03 18:32:50","created_at":"2024-11-25 20:49:56","author":"ケンノジ 藤咲ユウ","upload_id":1012,"status":1,"cat_id":0,"likes_num":4,"collect_num":53,"view_num":3235,"can_comment":1,"comment_num":1,"user_id":9999,"process":"连载中","sex":"全部","tags":"欢乐向 轻小说","creativity":"转载","score_num":8,"score":"5.0","process_at":"2026-10-03 07:23:23","hot_value":13,"latestChapterInfo":"{\"name\":\"58\\u8bdd\",\"id\":650223,\"car_id\":54597}","color":{"r":191,"g":171,"b":161},"has_content_score_num":0,"cover_expired_at":1721712982,"legal":0,"identity":"73c82d257be1670ee46ee507c7180256","webCode":"zaimanhua","is_deal":1,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=56109","chapter_num":65,"is_vip":0,"man":0,"comment_num_without_chapter":1,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"日本","read_mode":1,"dis_type":"条漫","length":"","color_type":"黑白","is_audit":1,"sub_num":1,"first_char":"Y"}}],["$","$Ld",null,{"item":{"id":136644,"name":"妈妈冒险者，靠登录奖励觉醒了【主妇】技能。凭借每周拿到的任务传单努力开展冒险者生活！ ","cover":"https://cdm.vomicer.com/611a4ccdafe4289dfc25b5b4248732ca-cover?sign=cf17dc1b8f52b117a4b9d7a2de9c9e0e&t=1791024603&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"身为二孩母亲的卡秋娅，在养育孩子的同时兼职做着冒险者行李搬运工的工作。正当她每日奔波于育儿与工作之间时，某天竟获得女神赐予技能，从此开启全新冒险生涯！令人好奇的武器竟是...“长勺”与“锅盖”！？新手妈妈冒险者开启“悠闲无双”模式！轻松愉快的冒险谭，就此拉开帷幕！","updated_at":"2026-10-03 18:51:02","created_at":"2025-12-04 06:27:57","author":"京一 ユーコ 鴨川新一","upload_id":1010,"status":1,"cat_id":0,"likes_num":17,"collect_num":38,"view_num":2756,"can_comment":1,"comment_num":1,"user_id":9999,"process":"连载中","sex":"全部","tags":"轻小说","creativity":"转载","score_num":8,"score":"5.0","process_at":"2026-10-03 07:02:31","hot_value":43,"latestChapterInfo":"{\"name\":\"13\\u8bdd\",\"id\":650213,\"car_id\":136644}","color":{"r":124,"g":118,"b":109},"has_content_score_num":4,"cover_expired_at":null,"legal":0,"identity":"611a4ccdafe4289dfc25b5b4248732ca","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=84142","chapter_num":13,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"日本","read_mode":1,"dis_type":"条漫","length":"","color_type":"黑白","is_audit":1,"sub_num":0,"first_char":"M"}}],["$","$Ld",null,{"item":{"id":111554,"name":"拔出圣剑的勇者变成了女孩子","cover":"https://cdm.vomicer.com/a9f94bec6cdbce6cd1816073d3be5dba-cover?sign=eaeac615d14b87c4f8b119f32d953554&t=1791024603&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"为了拯救世界而拔出圣剑的勇者阿克斯！但是他的性癖好使圣剑的力量失控……⁉可爱勇者前所未有的冒险，现在开始！","updated_at":"2026-10-03 18:37:37","created_at":"2025-03-02 18:15:15","author":"福岡太朗","upload_id":1005,"status":1,"cat_id":0,"likes_num":0,"collect_num":34,"view_num":2394,"can_comment":1,"comment_num":1,"user_id":9999,"process":"连载中","sex":"全部","tags":"欢乐向 TS","creativity":"转载","score_num":2,"score":"5.0","process_at":"2026-10-03 06:46:07","hot_value":11,"latestChapterInfo":"{\"name\":\"20\\u8bdd\",\"id\":650186,\"car_id\":111554}","color":{"r":207,"g":192,"b":210},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"a9f94bec6cdbce6cd1816073d3be5dba","we