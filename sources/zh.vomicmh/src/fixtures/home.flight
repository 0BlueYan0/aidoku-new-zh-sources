ges/comic/detail?id=84791","chapter_num":0,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"日本","read_mode":1,"dis_type":"条漫","length":"","color_type":"黑白","is_audit":1,"sub_num":0,"first_char":"Z"}}],["$","$Lc",null,{"item":{"id":137806,"name":"狂人图书馆版","cover":"https://cdm.vomicer.com/a6263866781084e54b7420c8d8410e93-cover?sign=b5e77b4c14d90556477a467ee04edf3f&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"从疯子首次登场，到他神秘的身世，再到他穿越时空和波普艺术荒诞的冒险；跟随弗兰克·爱因斯坦的超级英雄化身疯子，在Snap City展开冒险，邂逅众多永恒的角色和反派。这部作品是对超级英雄小说、形而上学哲学、20世纪50年代科幻电影、流行音乐等等的真正致敬，是一部幽默而真挚的漫画经典！","updated_at":"2026-10-03 00:35:58","created_at":"2026-01-13 09:11:44","author":"Michael Allred","upload_id":1080,"status":1,"cat_id":0,"likes_num":0,"collect_num":0,"view_num":734,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"","creativity":"转载","score_num":1,"score":"5.0","process_at":"2026-04-20 13:31:56","hot_value":0,"latestChapterInfo":"{\"name\":\"1\\u537711\\u8bdd\",\"id\":610416,\"car_id\":137806}","color":{"r":215,"g":194,"b":197},"has_content_score_num":1,"cover_expired_at":null,"legal":0,"identity":"a6263866781084e54b7420c8d8410e93","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=84783","chapter_num":11,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"欧美","read_mode":1,"dis_type":"条漫","length":"","color_type":"彩漫","is_audit":1,"sub_num":0,"first_char":"K"}}],["$","$Lc",null,{"item":{"id":137990,"name":"我和吸血家里蹲的同居生活（页漫版）","cover":"https://cdm.vomicer.com/88c0ab599f3e1a679a18d483c7ae7087-cover?sign=2ebd75db1ad0cdddd46c8f0ee4f3c202&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"条漫改页漫大挑战！\n夜幕低垂，华灯初上。努力一天回到家门前的独居少女，遇到了一团空有长相弱不禁风还轻如草灰的“人型物体”，并好心地将其带回家准备卖掉。在不可说出的禁语出口的瞬间，觊觎生命的非人之物得以侵入少女的家中，贪婪地渴求着少女的生命。“多谢款待”。","updated_at":"2026-10-03 17:34:02","created_at":"2026-01-23 01:05:47","