,"is_audit":1,"sub_num":0,"first_char":"D"}}],["$","$Lc",null,{"item":{"id":136962,"name":"荒川、看过来！","cover":"https://cdm.vomicer.com/a9bddf7a921e675c18c19615465142c9-cover?sign=a89b48bae4b76063661655a3207a9082&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"从约会开始试试吧！","updated_at":"2026-10-03 11:33:15","created_at":"2025-12-14 11:18:02","author":"横川そよぎ","upload_id":1043,"status":1,"cat_id":0,"likes_num":0,"collect_num":2,"view_num":355,"can_comment":1,"comment_num":0,"user_id":9999,"process":"其他","sex":"全部","tags":"","creativity":"转载","score_num":1,"score":"4.0","process_at":"2025-12-14 11:18:21","hot_value":0,"latestChapterInfo":"[]","color":{"r":161,"g":190,"b":210},"has_content_score_num":1,"cover_expired_at":null,"legal":0,"identity":"a9bddf7a921e675c18c19615465142c9","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=84329","chapter_num":1,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"日本","read_mode":1,"dis_type":"条漫","length":"","color_type":"黑白","is_audit":1,"sub_num":0,"first_char":"H"}}],["$","$Lc",null,{"item":{"id":137123,"name":"遭到驱逐的龙师在邻国不小心大开无双 从弱小国家转身成为大陆最强龙之乐园","cover":"https://cdm.vomicer.com/bd8ce2a956bb1c918245df2f7b2041dc-cover?sign=5bf4a77b58651a7dd5e3a72abe271f8e&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"德拉桀尼亚的龙师“布里德”，因国家的裁军政策而遭到解雇，然而在该国受他照顾的龙竟全都跟着他一起逃了出去！面临这种绝对会遭到误会的情况，布里德要如何和信赖他的群龙找到属于他们的出路？由被解雇的龙师＆100头龙所带来的最强建国故事。\n","updated_at":"2026-10-03 17:47:37","created_at":"2025-12-21 02:35:21","author":"謙虚なサークル 佐藤駿光","upload_id":1006,"status":1,"cat_id":0,"likes_num":0,"collect_num":3,"view_num":682,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"","creativity":"转载","score_num":0,"score":"0.0","process_at":"2025-12-21 02:38:26","hot_value":0,"latestChapterInfo":"[]","color":{"r":133,"g":121,"b":135},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"bd8ce2a956bb1c918245df2f7b2041dc","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=84421","chapter_num":0,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"日本","read_mode":1,"dis_type":"条漫","length":"","color_type":"黑白","is_audit":1,"sub_num":0,"first_char":"Z"}}],["$","$Lc",null,{"item":{"id":137132,"name":"单恋你一生","cover":"https://cdm.vomicer.com/9c643ad8854d9770409fd6f2ec23b401-cover?sign=612ac5e43624919efd415eebf4ab86c3&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"错位的爱，永远得不到回报。","updated_at":"2026-10-02 16:55:21","created_at":"2025-12-21 04:55:04","author":"如日やさか","upload_id":1039,"status":1,"cat_id":0,"likes_num":3,"collect_num":3,"view_num":588,"can_comment":1,"comment_num":2,"user_id":9999,"process":"其他","sex":"全部","tags":"","creativity":"转载","score_num":0,"score":"0.0","process_at":"2025-12-21 04:55:07","hot_value":8,"latestChapterInfo":"[]","color":{"r":213,"g":115,"b":63},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"9c643ad8854d9770409fd6f2ec23b401","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=84426","chapter_num":0,"is_vip":0,"man":0,"comment_num_without_chapter":2,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"日本","read_mode":1,"dis_type":"条漫","length":"","color_type":"彩漫","is_audit":1,"sub_num":0,"first_char":"D"}}],["$","$Lc",null,{"item":{"id":137171,"name":"欢迎来到修道院，这里是被放逐少女们的乐园","cover":"https://cdm.vomicer.com/829c31f55053aca9c2785fdde8c238f7-cover?sign=ba21fe48ed8ccbd0d0e2ec32b03a0b29&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"这是一座地处边境、戒律森严，只收容因各种缘由被家族驱逐的“有故事”女性的修道院。可它的真面目却是——年轻的院长米兰达与修女们收集着全国的八卦趣闻，在闲谈中寻欢作乐，堪称姑娘们自由享乐的天堂！这座修道院里，时常会迎来形形色色的贵族千金：有被未婚夫抛弃的，有因被迫与粗暴男子订婚而痛苦不堪的，也有一心盼着未婚夫回心转意的……我们会将靠消遣时光搜集来的情报化为武器，为迷途的羔羊们扫去所有烦忧。所以，请尽情去追逐属于你们的幸福吧！这是身处逆境的少女们逆转命运、奔赴光明未来的爽快大戏","updated_at":"2026-10-02 12:53:42","created_a