fca-cover?sign=240d9abeb05f3ebcedf02897ddc6bfb3&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"从湖边别墅到海边别墅，随之而来的是新的希望还是新的牢笼？为在末日中存续火种，十位精英受神秘人MAX（马克斯）的召集，齐聚海边别墅。然而，最危险的威胁并非来自外界，而是随着猜忌与危机悄然潜伏。在这关乎存亡的最终试验场，人性与命运，究竟会碰撞出怎样的火花？","updated_at":"2026-10-03 16:01:12","created_at":"2025-11-18 00:31:56","author":"James Tynion IV Alvaro Martínez Bueno","upload_id":1009,"status":1,"cat_id":0,"likes_num":0,"collect_num":4,"view_num":748,"can_comment":1,"comment_num":0,"user_id":9999,"process":"连载中","sex":"全部","tags":"惊悚","creativity":"转载","score_num":0,"score":"0.0","process_at":"2026-09-28 00:10:41","hot_value":0,"latestChapterInfo":"{\"name\":\"8\\u5377\",\"id\":649067,\"car_id\":133559}","color":{"r":84,"g":77,"b":90},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"f145a07c62b2955ece98b1ba01de0fca","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=83867","chapter_num":8,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"欧美","read_mode":1,"dis_type":"条漫","length":"","color_type":"彩漫","is_audit":1,"sub_num":0,"first_char":"H"}}],["$","$Lc",null,{"item":{"id":133629,"name":"神秘博士：从前有一位时间领主","cover":"https://cdm.vomicer.com/6dbccc7f234eebf16e7e3a096f63dd86-cover?sign=5232868c65a676204206e7c37f839ccd&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"被一种以“故事”为能量的古老外星族群 炎语者 俘获后，玛莎·琼斯 被迫不停讲述博士的冒险，否则就将被他们彻底吞噬。\n于是，一个又一个关于 第十任博士 的惊险篇章在绝境中被迫展开： 全新的怪物、熟悉的宿敌、跨越时间与星际的危机——每一个故事都让玛莎离生存更近一步，也让隐藏的真相愈发危险。\n然而，炎语者想要的不只是故事——他们渴望吞噬的是传奇本身。\n当“传说”开始反噬现实，玛莎不得不直面博士最脆弱的一面；与此同时，博士也将迎战一个能够改写记忆、侵蚀历史的恐怖存在。\n本卷亦收录特别篇章： 第九任博士与罗斯 的全新冒险，揭开另一段深埋在时间阴影中的秘密。\n在一个故事足以杀人的宇宙里，唯一的武器，就是继续讲下去。","updated_at":"2026-10-02 11:12:39","created_at":"2025-11-20 03:11:18","author":"Dan Slott Christopher Jones Matthew Dow Smith","upload_id":1031,"status":1,"cat_id":0,"likes_num":0,"collect_num":0,"view_num":412,"can_comment":1,"comment_num":0,"user_id":9999,"process":"其他","sex":"全部","tags":"","creativity":"转载","score_num":0,"score":"0.0","process_at":"2025-11-20 03:12:31","hot_value":0,"latestChapterInfo":"[]","color":{"r":118,"g":97,"b":72},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"6dbccc7f234eebf16e7e3a096f63dd86","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=83924","chapter_num":1,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"欧美","read_mode":1,"dis_type":"条漫","length":"","color_type":"彩漫","is_audit":1,"sub_num":0,"first_char":"S"}}],["$","$Lc",null,{"item":{"id":136690,"name":"派对咖大混乱，对托雷噼求理睬狂欢节","cover":"https://cdm.vomicer.com/0d2f8fc49d5862ff5ccb75c7994ecf05-cover?sign=3edcf506ce04b0839d459c4c611e62fe&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"是狂欢节和托雷噼的日常喜剧！","updated_at":"2026-10-01 08:04:20","created_at":"2025-12-04 09:00:14","author":"うぐら丸","upload_id":1004,"status":1,"cat_id":0,"likes_num":0,"collect_num":0,"view_num":332,"can_comment":1,"comment_num":0,"user_id":9999,"process":"其他","sex":"全部","tags":"欢乐向","creativity":"转载","score_num":0,"score":"0.0","process_at":"2025-12-04 09:00:55","hot_value":0,"latestChapterInfo":"[]","color":{"r":177,"g":153,"b":157},"has_content_score_num":0,"cover_expired_at":null,"legal":0,"identity":"0d2f8fc49d5862ff5ccb75c7994ecf05","webCode":"zaimanhua","is_deal":0,"source_url":"https://m.zaimanhua.com/pages/comic/detail?id=84064","chapter_num":1,"is_vip":0,"man":0,"comment_num_without_chapter":0,"ratio":"1.00","is_lock":0,"is_violation":0,"region":"日本","read_mode":1,"dis_type":"条漫","length":"","color_type":"黑白","is_audit":1,"sub_num":0,"first_char":"P"}}],["$","$Lc",null,{"item":{"id":136773,"name":"(C106) 爱丽丝想要去海边!","cover":"https://cdm.vomicer.com/5c62a8710d1176b0a7ea81babc8b3021-cover?sign=3c77b5ad5135a2413c590e2b77fe7163&t=1791024607&imageMogr2/thumbnail/576x/format/webp/quality/75","intro":"在爱丽丝的提议下，游戏开发部计划去海边玩。","update